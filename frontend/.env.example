# Frontend environment (Vite)
# Copy to .env.local for local builds.

# Required for Android / Capacitor production builds.
VITE_API_URL=https://your-backend.example.com

# Optional admin signup gate (must match backend ADMIN_SIGNUP_CODE when enabled).
VITE_ADMIN_SIGNUP_CODE=

# App version label (used as Sentry release fallback).
VITE_APP_VERSION=1.0.0

# Kiosk idle reset in milliseconds. 0 disables auto-return to /kids.
VITE_ANDROID_KIOSK_IDLE_MS=600000

# Parent code required to leave kiosk mode on a dedicated tablet.
# CHANGE THIS before deploying any tablet. Parents can also set it from the dashboard.
VITE_KIOSK_EXIT_CODE=1379

# Set to true to start the supervised kiosk (screen pinning) on first launch.
# Dedicated tablets provisioned as device owner do not need this.
VITE_KIOSK_AUTO_ENABLE=false

# Sentry error monitoring (optional — disabled when VITE_SENTRY_DSN is empty)
VITE_SENTRY_DSN=
VITE_SENTRY_ENVIRONMENT=production
VITE_SENTRY_RELEASE=
VITE_SENTRY_TRACES_SAMPLE_RATE=0.2
VITE_SENTRY_REPLAYS_SAMPLE_RATE=0.1
